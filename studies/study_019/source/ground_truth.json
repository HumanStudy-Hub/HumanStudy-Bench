  "validation_criteria": {
    "pass_threshold": 0.7,
    "pass_policy": "fail closed on environment integrity; report behavioral alignment as diagnostics",
    "required_tests": [
      {
        "test_id": "source_scenario_integrity",
        "description": "Every participant receives the complete source-derived scenario set once, and all stored scenario identifiers, signatures, and fingerprints match the compiled public materials.",
        "weight": 0.4
      },
      {
        "test_id": "randomized_execution_integrity",
        "description": "Both sub-studies receive balanced participant assignments, each participant's scenario order is randomized, and the original response domains are enforced.",
        "weight": 0.2
      },
      {
        "test_id": "participant_information_integrity",
        "description": "Prompts include all participant-facing private and public evidence but do not expose Bayesian answers, source outcomes, or data labels.",
        "weight": 0.25
      },
      {
        "test_id": "procedure_integrity",
        "description": "Instructions are shown before the first scenario, no trial-level answer feedback is provided, and confidence judgments remain in the published 50-100 range.",
        "weight": 0.15
      }
    ],
    "required_environment_checks": [
      "each Study 1 participant receives all 24 source scenarios exactly once",
      "each Study 2 participant receives all 40 source scenarios exactly once",
      "scenario order is a deterministic participant-level shuffle",
      "choices and confidence judgments are parseable and in range",
      "agent-visible prompts contain only participant-facing evidence",
      "stored scenario fields match the compiled source materials",
      "no trial-level answer feedback is provided"
    ]
  },
  "source_limitations": [
    "The public archive contains raw data and variable coding but not the original questionnaire file or original German wording.",
    "The participant-facing English instructions are a faithful semantic reconstruction from the article's Procedure sections, not a verbatim questionnaire transcription.",
    "The runtime does not fit the paper's participant-level JAGS cognitive models; it reports directly observable choice and confidence diagnostics.",
    "The Figshare Study 1 data recode mirrored scenarios to the corresponding base orientation. The material compiler reverses that recoding when constructing visible Urn A versus Urn B rates."
  ]
