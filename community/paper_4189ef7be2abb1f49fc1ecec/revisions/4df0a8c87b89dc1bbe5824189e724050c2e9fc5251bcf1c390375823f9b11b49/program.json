    {
      "id": "reading-notes",
      "kind": "limitation",
      "title": "What the evidence supports",
      "studyIds": [],
      "fields": [
        {
          "id": "limits",
          "label": "Interpretation and limits",
          "value": "The written sketches and trait checklists measure impressions of described people. The importance of warmth was context-dependent, not a fixed weight across all lists.",
          "evidenceIds": [
            "e-01",
            "e-02",
            "e-03",
            "e-04",
            "e-05",
            "e-06"
          ],
          "state": "check",
          "origin": "derived",
          "derivation": "Scope of the published evidence and, where linked, differences from the Bench adaptation."
        }
      ],
      "evidenceIds": [
