    },
    {
      "id": "scope-01-design",
      "kind": "design",
      "title": "How it was studied",
      "studyIds": [
        "scope-01"
      ],
      "fields": [
        {
          "id": "design",
          "label": "Participants, procedure and measures",
          "value": "Compare otherwise similar trait lists with warm versus cold, remove that distinction, then compare polite versus blunt. Participants write impressions and select or rank traits.",
          "evidenceIds": [
            "e-01"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-01"
      ]
    },
    {
      "id": "scope-01-result",
      "kind": "result",
      "title": "What the paper reports",
      "studyIds": [
        "scope-01"
      ],
      "fields": [
        {
          "id": "result",
          "label": "Result",
          "value": "Warm versus cold changed many inferred traits; polite versus blunt had more localized effects. When warm and cold were absent, participants still inferred those qualities in different directions.",
          "evidenceIds": [
            "e-01"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-01"
      ]
    },
    {
      "id": "scope-02-design",
      "kind": "design",
      "title": "How it was studied",
      "studyIds": [
        "scope-02"
      ],
      "fields": [
        {
          "id": "design",
          "label": "Participants, procedure and measures",
          "value": "Move focal traits into different surrounding lists and elicit rankings or synonyms. Separate groups see different lists in Experiment V.",
          "evidenceIds": [
            "e-02"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-02"
      ]
    },
    {
      "id": "scope-02-result",
      "kind": "result",
      "title": "What the paper reports",
      "studyIds": [
        "scope-02"
      ],
      "fields": [
        {
          "id": "result",
          "label": "Result",
          "value": "The same words changed importance or meaning depending on the other traits. In different contexts, the same descriptor was interpreted in qualitatively different ways.",
          "evidenceIds": [
            "e-02"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-02"
      ]
    },
    {
      "id": "scope-03-design",
      "kind": "design",
      "title": "How it was studied",
      "studyIds": [
        "scope-03"
      ],
      "fields": [
        {
          "id": "design",
          "label": "Participants, procedure and measures",
          "value": "Reverse the order of lists with identical terms and collect sketches and checklist responses. Experiment VII repeats the order comparison using another list.",
          "evidenceIds": [
            "e-03"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-03"
      ]
    },
    {
      "id": "scope-03-result",
      "kind": "result",
      "title": "What the paper reports",
      "studyIds": [
        "scope-03"
      ],
      "fields": [
        {
          "id": "result",
          "label": "Result",
          "value": "The initial traits guided how people interpreted later ones. Reversing the list changed overall impressions even when the terms were held constant.",
          "evidenceIds": [
            "e-03"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-03"
      ]
    },
    {
      "id": "scope-04-design",
      "kind": "design",
      "title": "How it was studied",
      "studyIds": [
        "scope-04"
      ],
      "fields": [
        {
          "id": "design",
          "label": "Participants, procedure and measures",
          "value": "People first form separate impressions from two lists, then try to combine the descriptions into an impression of one person.",
          "evidenceIds": [
            "e-04"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-04"
      ]
    },
    {
      "id": "scope-04-result",
      "kind": "result",
      "title": "What the paper reports",
      "studyIds": [
        "scope-04"
      ],
      "fields": [
        {
          "id": "result",
          "label": "Result",
          "value": "Participants could form separate impressions readily but often found the combined task harder and reinterpreted traits when making a single coherent person.",
          "evidenceIds": [
            "e-04"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-04"
      ]
    },
    {
      "id": "scope-05-design",
      "kind": "design",
      "title": "How it was studied",
      "studyIds": [
        "scope-05"
      ],
      "fields": [
        {
          "id": "design",
          "label": "Participants, procedure and measures",
          "value": "Compare impressions from warm or cold alone with corresponding trait lists and use a more targeted follow-up checklist.",
          "evidenceIds": [
            "e-05"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-05"
      ]
    },
    {
      "id": "scope-05-result",
      "kind": "result",
      "title": "What the paper reports",
      "studyIds": [
        "scope-05"
      ],
      "fields": [
        {
          "id": "result",
          "label": "Result",
          "value": "Warmth and coldness produced different inferences when isolated and when paired with other traits. The surrounding traits shifted the breadth and direction of what people inferred.",
          "evidenceIds": [
            "e-05"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-05"
      ]
    },
    {
      "id": "scope-06-design",
      "kind": "design",
      "title": "How it was studied",
      "studyIds": [
        "scope-06"
      ],
      "fields": [
        {
          "id": "design",
          "label": "Participants, procedure and measures",
          "value": "Ask which short trait descriptions resemble one another, then compare the apparent meaning of focal traits across descriptions.",
          "evidenceIds": [
            "e-06"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-06"
      ]
    },
    {
      "id": "scope-06-result",
      "kind": "result",
      "title": "What the paper reports",
      "studyIds": [
        "scope-06"
      ],
      "fields": [
        {
          "id": "result",
          "label": "Result",
          "value": "Lists sharing a word were not necessarily perceived as most similar. Conversely, a trait in one description could resemble its nominal opposite in another context.",
          "evidenceIds": [
            "e-06"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-06"
      ]
    }
