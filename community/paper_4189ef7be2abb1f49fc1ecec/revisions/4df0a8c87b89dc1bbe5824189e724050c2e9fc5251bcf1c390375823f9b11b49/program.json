      "title": "Main takeaway",
      "studyIds": [],
      "fields": [
        {
          "id": "finding",
          "label": "Across the paper",
          "value": "Changing a trait or its position can change what the other traits mean. The experiments support a context-sensitive account of first impressions.",
          "evidenceIds": [
            "e-01",
            "e-02",
