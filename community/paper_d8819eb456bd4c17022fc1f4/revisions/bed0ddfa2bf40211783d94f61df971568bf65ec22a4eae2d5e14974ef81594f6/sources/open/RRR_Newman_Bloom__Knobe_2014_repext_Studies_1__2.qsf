44","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1314"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1322","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q52","QuestionType":"Slider","Selector":"HSLIDER","Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"QuestionID":"QID1322"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1333","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q63","QuestionType":"Slider","Selector":"HSLIDER","Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"Labels":[],"QuestionID":"QID1333"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1432","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q162","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1432"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1452","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q182","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Statement 1"},"2":{"Display":"Click to write Statement 2"},"3":{"Display":"Click to write Statement 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":6,"Answers":{"1":{"Display":"Click to write Scale Point 1"},"2":{"Display":"Click to write Scale Point 2"},"3":{"Display":"Click to write Scale Point 3"},"4":{"Display":"Click to write Scale Point 4"},"5":{"Display":"Click to write Scale Point 5"}},"AnswerOrder":["1","2","3","4","5"],"ChoiceDataExportTags":false,"QuestionID":"QID1452"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1615","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q345","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1615"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1224","SecondaryAttribute":"Consent Form This study is conducted by Gilad Feldman of the psychology department at University...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p style=\"text-align: center;\"><span style=\"font-size: 24px;\"><strong><u>Consent Form<\/u><\/strong><\/span><\/p>\n\n<p><br>\nThis study is conducted by Gilad Feldman of the psychology department at University of Hong Kong and colleagues.&nbsp;If you have questions or concerns regarding this project, please do not hesitate to contact Gilad Feldman <a href=\"mailto:gfeldman@hku.hk\">gfeldman@hku.hk<\/a> at any time.<br>\n&nbsp;<br>\n<strong>Purpose of the study&nbsp;<\/strong><br>\nTo understand how people think, feel, make decisions, and act in various types of situations. Preferences and individual differences between people, as well as both internal and external factors, may affect these types of responses and this research intends to uncover and\/or understand these processes.&nbsp;<br>\n&nbsp;<br>\n<strong>Procedures.<\/strong><br>\nThis study will ask you to complete a set of questionnaires requiring decision making in various scenarios. The duration of this study has been indicated on the task that you accepted.<br>\n&nbsp;<br>\n<strong>Potential risks<\/strong>.<br>\nThis procedure has no known risks greater than those of ordinary daily life.&nbsp;<br>\n&nbsp;<br>\n<strong>Potential benefits<\/strong>.<br>\nThis study aims to add to existing research line in the field of social-cognitive-personality&nbsp;psychology. We also hope that this study can provide you with a learning experience of participating in psychological research and possibly learning more about yourself and your beliefs, evaluations, preferences, personality, etc..<br>\n&nbsp;<br>\n<strong>Compensation<\/strong>.<br>\nCompensation is offered through the online platform.&nbsp;The level of compensation has been indicated on the task that you accepted.<br>\n&nbsp;<br>\n<strong>Confidentiality.<\/strong><br>\nYour questionnaire responses are anonymous and strictly confidential. No personal identifiers are kept. Information obtained will only be used as aggregates for research purposes. Deidentified\/Anonymized version of the data with no confidential data will be shared publicly to allow the reproduction and reproducibility of our research.<br>\n&nbsp;<br>\n<b>Participation and withdrawal.<\/b><br>\nYour participation is voluntary. This means that you can choose to stop at any time&nbsp;without negative consequences. If at any time you wish to withdraw, please simply indicate eight zeros as your completion code, and you will receive compensation regardless.&nbsp;<br>\n&nbsp;&nbsp;<br>\n<strong>Questions and concerns<\/strong><br>\nIf you have any questions about the research, please feel free to contact Gilad Feldman at the University of Hong Kong (<a href=\"mailto:gfeldman@hku.hk\">gfeldman@hku.hk<\/a>). If you have questions about your rights as a research participant, contact the Human Research Ethics Committee, HKU (+852 2241-5267). EA210265<br>\n&nbsp;<br>\nPlease print a copy of this consent form for your records, if you so desire.<\/p>","DefaultChoices":false,"DataExportTag":"consentform","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Consent Form This study is conducted by Gilad Feldman of the psychology department at University...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID1224","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"QuestionText_Unsafe":"<p style=\"text-align: center;\"><span style=\"font-size: 24px;\"><strong><u>Consent Form<\/u><\/strong><\/span><\/p>\n\n<p><br \/>\nThis study is conducted by Gilad Feldman of the psychology department at University of Hong Kong and colleagues.&nbsp;If you have questions or concerns regarding this project, please do not hesitate to contact Gilad Feldman <a href=\"mailto:gfeldman@hku.hk\">gfeldman@hku.hk<\/a> at any time.<br \/>\n&nbsp;<br \/>\n<strong>Purpose of the study&nbsp;<\/strong><br \/>\nTo understand how people think, feel, make decisions, and act in various types of situations. Preferences and individual differences between people, as well as both internal and external factors, may affect these types of responses and this research intends to uncover and\/or understand these processes.&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>Procedures.<\/strong><br \/>\nThis study will ask you to complete a set of questionnaires requiring decision making in various scenarios. The duration of this study has been indicated on the Amazon Mechanical Turk HIT that you accepted.<br \/>\n&nbsp;<br \/>\n<strong>Potential risks<\/strong>.<br \/>\nThis procedure has no known risks greater than those of ordinary daily life.&nbsp;<br \/>\n&nbsp;<br \/>\n<strong>Potential benefits<\/strong>.<br \/>\nThis study aims to add to existing research line in the field of social-cognitive-personality&nbsp;psychology. We also hope that this study can provide you with a learning experience of participating in psychological research and possibly learning more about yourself and your beliefs, evaluations, preferences, personality, etc..<br \/>\n&nbsp;<br \/>\n<strong>Compensation<\/strong>.<br \/>\nCompensation is offered through the Amazon Mechanical Turk platform.&nbsp;The level of compensation has been indicated on the Amazon Mechanical Turk HIT that you accepted.<br \/>\n&nbsp;<br \/>\n<strong>Confidentiality.<\/strong><br \/>\nYour questionnaire responses are anonymous and strictly confidential. No personal identifiers are kept. Information obtained will only be used as aggregates for research purposes.<br \/>\n&nbsp;<br \/>\n<strong>Participation and withdrawl.<\/strong><br \/>\nYour participation is voluntary. This means that you can choose to stop at any time&nbsp;without negative consequences. If at any time you wish to withdraw, please simply indicate eight zeros as your completion code on MTurk, and you will receive compensation regardless.&nbsp;<br \/>\n&nbsp;&nbsp;<br \/>\n<strong>Questions and concerns<\/strong><br \/>\nIf you have any questions about the research, please feel free to contact Gilad Feldman at the University of Hong Kong (<a href=\"mailto:gfeldman@hku.hk\">gfeldman@hku.hk<\/a>). If you have questions about your rights as a research participant, contact the Human Research Ethics Committee, HKU (+852 2241-5267).<br \/>\n&nbsp;<br \/>\nPlease print a copy of this consent form for your records, if you so desire.<\/p>"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1338","SecondaryAttribute":"Corrupted police officer Imagine someone is different from you in almost every way -- this person...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:22px;\"><strong><u>Corrupted police officer<\/u><\/strong><\/span><br>\n<br>\nImagine someone is different from you in almost every way -- this person has a different occupation and prefers different things than you.<br>\n<br>\n<span style=\"font-size:22px;\">This person is a police officer and works in a station that has never supported police corruption. In the past, this person never participated in corruption and always behaved ethically.<br>\n<u>Now, however, this person engages in corrupt activities and does not conduct oneself in an ethical manner<\/u>.&nbsp;<\/span>","DefaultChoices":false,"DataExportTag":"po-neg-int","QuestionID":"QID1338","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Corrupted police officer Imagine someone is different from you in almost every way -- this person...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1498","SecondaryAttribute":"Corrupted police officer Imagine someone is different from you in almost every way -- this person...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:22px;\"><strong><u>Corrupted police officer<\/u><\/strong><\/span><br \/>\n<br \/>\nImagine someone is different from you in almost every way -- this person has a different occupation and prefers different things than you.<br \/>\n<br \/>\nThis person is a police officer and works in a station that has never supported police corruption. In the past, this person never participated in corruption and always behaved ethically. Now, however, this person engages in corrupt activities and does not conduct oneself in an ethical manner.&nbsp;","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Corrupted police officer Imagine someone is different from you in almost every way -- this person...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"QuestionText_Unsafe":"<span style=\"font-size:22px;\"><strong><u>Corrupted police officer<\/u><\/strong><\/span><br \/>\n<br \/>\nImagine someone is different from you in almost every way -- this person has a different occupation and prefers different things than you.<br \/>\n<br \/>\nThis person is a police officer and works in a station that has never supported police corruption. In the past, this person never participated in corruption and always behaved ethically. Now, however, this person engages in corrupt activities and does not conduct oneself in an ethical manner.&nbsp;","DataExportTag":"Q1498","QuestionID":"QID1498"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1451","SecondaryAttribute":"Country or city, do you have a preference? \u00a0 Please indicate your own personal preferences:","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><strong><u>Country or city<\/u><\/strong>, do you have a preference?<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>Please indicate your own personal preferences:<\/div>","DefaultChoices":false,"DataExportTag":"Country-City","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Country or city, do you have a preference? \u00a0 Please indicate your own personal preferences:","Choices":{"1":{"Display":"Strongly prefer the country"},"2":{"Display":"Prefer the country"},"4":{"Display":"No preference"},"5":{"Display":"Prefer the city"},"6":{"Display":"Strongly prefer the city"}},"ChoiceOrder":["1","2","4","5","6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"4":"3","5":"4","6":"5"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_d5twgEAWyuaAM0C":1},"index":0},{"ChoiceID":"2","Grades":{"SC_d5twgEAWyuaAM0C":2},"index":1},{"ChoiceID":"4","Grades":{"SC_d5twgEAWyuaAM0C":"3"},"index":2},{"ChoiceID":"5","Grades":{"SC_d5twgEAWyuaAM0C":"4"},"index":3},{"ChoiceID":"6","Grades":{"SC_d5twgEAWyuaAM0C":"5"},"index":4}],"Language":[],"NextChoiceId":7,"NextAnswerId":6,"QuestionID":"QID1451","VariableNaming":{"1":"Strongly prefer the country","2":"Prefer the country","4":"No preference","5":"Prefer the city","6":"Strongly prefer the city"},"QuestionText_Unsafe":"Please indicate your own personal preferences:"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"RS","PrimaryAttribute":"RS_1BQbA1Ii7hCyNL0","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1486","SecondaryAttribute":"Dishonest business practice Imagine someone who is different from you in almost every way -- this...","TertiaryAttribute":null,"Payload":{"QuestionText":"<u><strong><span style=\"font-size:22px;\">Dishonest business practice<\/span><\/strong><\/u><br \/>\n<br \/>\nImagine someone who is different from you in almost every way -- this person has a different occupation and prefers different things than you.<br \/>\n<br \/>\nThis person works in an environment that supports only honest business practices. In the past, this person has not participated in dishonest business practices. Now, however, this person believes that it is permissible to engage in dishonest business practices and behaves unethically.&nbsp;","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Dishonest business practice Imagine someone who is different from you in almost every way -- this...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4,"QuestionText_Unsafe":"<u><strong><span style=\"font-size:22px;\">Dishonest business practice<\/span><\/strong><\/u><br \/>\n<br \/>\nImagine someone who is different from you in almost every way -- this person has a different occupation and prefers different things than you.<br \/>\n<br \/>\nThis person works in an environment that supports only honest business practices. In the past, this person has not participated in dishonest business practices. Now, however, this person believes that it is permissible to engage in dishonest business practices and behaves unethically.&nbsp;","DataExportTag":"Q1486","QuestionID":"QID1486"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1329","SecondaryAttribute":"Dishonest business practices Imagine someone who is different from you in almost every way -- thi...","TertiaryAttribute":null,"Payload":{"QuestionText":"<u><strong><span style=\"font-size:22px;\">Dishonest business practices<\/span><\/strong><\/u><br \/>\n<br \/>\nImagine someone who is different from you in almost every way -- this person has a different occupation and prefers different things than you.<br \/>\n<br \/>\n<span style=\"font-size:22px;\">This person works in an environment that supports only honest business practices. In the past, this person has not participated in dishonest business practices.<br \/>\n<u>Now, however, this person believes that it is permissible to engage in dishonest business practices and behaves unethically.&nbsp;<\/u><\/span>","DefaultChoices":false,"DataExportTag":"bus-neg-int","QuestionID":"QID1329","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Dishonest business practices Imagine someone who is different from you in almost every way -- thi...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":4}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1460","SecondaryAttribute":"Do you perceive this person's change as morally good or morally bad? ","TertiaryAttribute":null,"Payload":{"Q