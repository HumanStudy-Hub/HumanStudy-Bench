e},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":-100,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"CenterLabels":true,"MobileFirst":true},"QuestionDescription":"To what extent is the described change in line with accepted social norms? Please rate it on a sc...","Choices":{"1":{"Display":"Social Norm Measurement"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"Labels":{"1":{"Display":"Very much against social norms"},"2":{"Display":"Very much in line with social norms"}},"QuestionID":"QID1442"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1448","SecondaryAttribute":"To what extent is the described change in line with accepted social norms? Please rate it on a sc...","TertiaryAttribute":null,"Payload":{"QuestionText":"To what extent is the described change in line with accepted social norms?<br>\nPlease rate it on a scale from -100 (very much against social norms) to 100 (very much in line with social norms)","DefaultChoices":false,"DataExportTag":"Q178","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":-100,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"CenterLabels":true,"MobileFirst":true},"QuestionDescription":"To what extent is the described change in line with accepted social norms? Please rate it on a sc...","Choices":{"1":{"Display":"Social Norm Measurement"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"Labels":{"1":{"Display":"Very much against social norms"},"2":{"Display":"Very much in line with social norms"}},"QuestionID":"QID1448"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1424","SecondaryAttribute":"To what extent is the described change in line with accepted social norms?\u201d Please rate it on a s.","TertiaryAttribute":null,"Payload":{"QuestionText":"To what extent is the described change in line with accepted social norms?&rdquo;<br \/>\nPlease rate it on a scale from -100 (very much against social norms) to 100 (very much in line with social norms)","DefaultChoices":false,"DataExportTag":"Q154","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":-100,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"CenterLabels":true,"MobileFirst":true},"QuestionDescription":"To what extent is the described change in line with accepted social norms?\u201d Please rate it on a s...","Choices":{"1":{"Display":"Social Norm Measurement"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"Labels":{"1":{"Display":"Very much against social norms"},"2":{"Display":"Very much in line with social norms"}},"QuestionID":"QID1424"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1315","SecondaryAttribute":"Treating employees well Imagine someone who is different from you in almost every way -- this per...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong><u><span style=\"font-size:22px;\">Treating employees well <\/span><\/u><\/strong><br \/>\n<br \/>\nImagine someone who is different from you in almost every way -- this person has a different occupation and prefers different things than you.<br \/>\n<br \/>\n<span style=\"font-size:22px;\">This person used to mistreat employees. In the past, this person often yelled at them and publicly embarrassed them for minor infractions.<br \/>\n<u>Now, however, this person never yells at employees or does anything to embarrass them publicly<\/u>.<\/span>","DefaultChoices":false,"DataExportTag":"Bo-pos-int","QuestionID":"QID1315","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Treating employees well Imagine someone who is different from you in almost every way -- this per...","ChoiceOrder":[],"Randomization":"None","Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":4}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1358","SecondaryAttribute":"Turning into an alcoholic Imagine someone who is different from you in almost every way -- this p...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:22px;\"><u><strong>Turning into an alcoholic<\/strong><\/u><\/span><br \/>\n<br \/>\nImagine someone who is different from you in almost every way -- this person has a different occupation and prefers different things than you.<br \/>\n<br \/>\n<span style=\"font-size:22px;\">This person used to be a teetotaler. In the past, this person never tried a drink of alcohol and never expressed any interest in drinking.<br \/>\n<u>Now, however, this person is an alcoholic.<\/u><\/span>\n<div>\n<div>&nbsp;<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"al-neg-int","QuestionID":"QID1358","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Turning into an alcoholic Imagine someone who is different from you in almost every way -- this p...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":4}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1227","SecondaryAttribute":"We would like to thank you for taking part and hope you found it interesting. The experiments in...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p>We would like to thank you for taking part and hope you found it interesting.<br>\n<br>\nThe experiments in which you participated today were designed to examine how personal and environmental factors may affect human cognition and decision making. In psychology, it has been known that information can affect person\u2019s behavior to certain extent and that individual differences affect behavior. The purpose of the study was to know how exposure to stimuli and certain individual differences affect decision making and behavior.<br>\n<br>\nIt's important to note that all of the information that was collected today will be kept in complete confidentiality and there will no attempt or interest in connecting your provided personal information with your responses. This data will be used for research purposes alone and not shared or reported to anyone. We are not interested in any one participant\u2019s responses by themselves. Rather, we are interested in the general responses of all participants when they are combined together.<br>\n<br>\nWe ask that you please do not share the details of this study with anyone because they may be potential participants and knowing the purpose of the study beforehand may affect the results. Thank you very much for your participation.<br>\nIf you would like information about the results, or have further questions for us, please contact Gilad Feldman <a href=\"mailto:gfeldman@hku.hk\">gfeldman@hku.hk<\/a>&nbsp;at any time. You can also <a href=\"http:\/\/mgto.org\" target=\"_blank\">read more about Gilad's research in his website<\/a>.<br>\n&nbsp;<\/p>\n\n<p><strong>Please press NEXT (&gt;&gt;), and wait for confirmation and <u>your secret completion key<\/u><\/strong><\/p>","DataExportTag":"debrief","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We would like to thank you for taking part and hope you found it interesting. The experiments in...","ChoiceOrder":[],"GradingData":[],"Language":[],"QuestionID":"QID1227","DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"<p>We would like to thank you for taking part and hope you found it interesting.<br>\n<br>\nThe experiments in which you participated today were designed to examine how personal and environmental factors may affect human cognition and decision making. In psychology, it has been known that information can affect person\u2019s behavior to certain extent and that individual differences affect behavior. The purpose of the study was to know how exposure to stimuli and certain individual differences affect decision making and behavior.<br>\n<br>\nIt's important to note that all of the information that was collected today will be kept in complete confidentiality and there will no attempt or interest in connecting your provided personal information with your responses. This data will be used for research purposes alone and not shared or reported to anyone. We are not interested in any one participant\u2019s responses by themselves. Rather, we are interested in the general responses of all participants when they are combined together.<br>\n<br>\nWe ask that you please do not share the details of this study with anyone because they may be potential participants and knowing the purpose of the study beforehand may affect the results. Thank you very much for your participation.<br>\nIf you would like information about the results, or have further questions for us, please contact Gilad Feldman <a href=\"mailto:gfeldman@hku.hk\">gfeldman@hku.hk<\/a>&nbsp;at any time. You can also <a href=\"http:\/\/mgto.org\" target=\"_blank\">read more about Gilad's research in his website<\/a>.<br>\n&nbsp;<\/p>\n\n<p><strong>Please press NEXT (&gt;&gt;), and wait for confirmation and <u>your secret completion key<\/u><\/strong><\/p>"}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID1616","SecondaryAttribute":"What are your political views? Please choose the one that you feel best represents your political...","TertiaryAttribute":null,"Payload":{"QuestionText":"What are your political views? <br><br>Please choose the one that you feel best represents your political views: (if \"other\", then please write down which)<br>","DataExportTag":"politicalcat","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"What are your political views? Please choose the one that you feel best represents your political...","Choices":{"1":{"Display":"Conservative"},"2":{"Display":"Liberal"},"3":{"Display":"Independent"},"4":{"Display":"Other","TextEntry":"true"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID1616","RecodeValues":{"1":"1","2":"2","3":"3","4":"4"},"DataVisibility":{"Private":false,"Hidden":false},"GradingData":[{"ChoiceID":"1","Grades":{"SC_d5twgEAWyuaAM0C":1},"index":0},{"ChoiceID":"2","Grades":{"SC_d5twgEAWyuaAM0C":2},"index":1},{"ChoiceID":"3","Grades":{"SC_d5twgEAWyuaAM0C":3},"index":2},{"ChoiceID":"4","Grades":{"SC_d5twgEAWyuaAM0C":4},"index":3}],"VariableNaming":{"1":"Conservative","2":"Liberal","3":"Independent","4":"Other"}}},{"SurveyID":"SV_brLyDVuvvTEvGiG","Element":"SQ","PrimaryAttribute":"QID609","SecondaryAttribute":"What do you think the purpose of the study was? (one sentence)","TertiaryAttribute":null,"Payload":{"QuestionText":"What do you think the purpose of the study was? (one sentence)","DefaultChoices":false,"DataExportTag":"funnel-purpose","QuestionType":"TE","Selector":"ML","Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":680,"InputHeight":29},"QuestionDescription":"What do you think the purp