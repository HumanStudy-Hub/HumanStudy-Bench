      "studyIds": [
        "scope-04"
      ],
      "fields": [
        {
          "id": "design",
          "label": "Participants, procedure and measures",
          "value": "Students privately accepted or declined an actual request to wear a sign, then estimated peer responses and rated people they believed had accepted or declined. The study ended in debriefing.",
