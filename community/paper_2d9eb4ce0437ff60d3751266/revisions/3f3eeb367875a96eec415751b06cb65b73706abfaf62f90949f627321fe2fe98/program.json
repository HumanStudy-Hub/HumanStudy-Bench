      "studyIds": [
        "scope-03"
      ],
      "fields": [
        {
          "id": "design",
          "label": "Participants, procedure and measures",
          "value": "104 students read one of two sandwich-board scenarios. They indicated their hypothetical choice, estimated peer agreement, and judged typical people who would agree or refuse.",
          "evidenceIds": [
            "e-03"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
