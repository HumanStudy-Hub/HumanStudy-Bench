      "title": "What the paper reports",
      "studyIds": [
        "scope-02"
      ],
      "fields": [
        {
          "id": "result",
          "label": "Result",
          "value": "Estimates generally favored the respondent’s own category. Responses to different items came from the same people, so these are not 34 independent studies.",
          "evidenceIds": [
            "e-02"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-02"
      ]
    },
    {
