      "id": "scope-01-result",
      "kind": "result",
      "title": "What the paper reports",
      "studyIds": [
        "scope-01"
      ],
      "fields": [
        {
          "id": "result",
          "label": "Result",
          "value": "For each story, people estimated greater prevalence for their own choice than did those who chose the alternative. Trait judgments also depended on the rater’s own choice.",
          "evidenceIds": [
            "e-01"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-01"
