      "studyIds": [
        "scope-02"
      ],
      "fields": [
        {
          "id": "design",
          "label": "Participants, procedure and measures",
          "value": "Eighty students classified themselves on paired categories and estimated prevalence among students. The order of the two tasks varied. Of 35 items, 34 remained usable.",
          "evidenceIds": [
            "e-02"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
