    },
    {
      "id": "scope-03-result",
      "kind": "result",
      "title": "What the paper reports",
      "studyIds": [
        "scope-03"
      ],
      "fields": [
        {
          "id": "result",
          "label": "Result",
          "value": "Estimates differed by own choice. Refusers inferred stronger traits from acquiescence than refusal; the contrast was weaker among those who would agree.",
          "evidenceIds": [
            "e-03"
          ],
          "state": "check",
          "origin": "reported"
        }
      ],
      "evidenceIds": [
        "e-03"
      ]
    },
