{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanstudy-hub.org/contracts/human-program-v2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "intent": {
      "enum": [
        "reconstruct",
        "codesign"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "authors",
        "filename"
      ],
      "additionalProperties": false
    },
    "studies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "type": {
            "enum": [
              "empirical",
              "analysis",
              "unspecified"
            ]
          },
          "description": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "intent",
    "source",
    "studies",
    "nodes",
    "steps",
    "relations",
    "evidence",
    "issues"
  ],
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "value": {},
        "origin": {
          "enum": [
            "verbatim",
            "reported",
            "derived",
            "researcher",
            "implementation",
            "unknown"
          ]
        },
        "state": {
          "enum": [
            "confirmed",
            "check",
            "decision",
            "missing"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "derivation": {
          "type": "string"
        },
        "studyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "origin",
        "state",
        "evidenceIds"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "studyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "conditionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "description": "Experimental conditions (nodes of kind \"condition\") this node belongs to. Steps or nodes in different phases that share a condition id run in the same condition. Omit for content shared by all conditions."
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "studyIds",
        "fields",
        "evidenceIds"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "studyId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "kind": {
          "enum": [
            "action",
            "sequence",
            "repeat",
            "branch",
            "parallel",
            "interaction",
            "custom"
          ],
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "actorIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "inputIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "outputIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "visibleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "next": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "to": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "when": {
                "type": "string"
              }
            },
            "required": [
              "to"
            ],
            "additionalProperties": false
          }
        },
        "rule": {
          "$ref": "#/$defs/field"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "conditionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "description": "Experimental conditions (nodes of kind \"condition\") this step belongs to. Steps or nodes in different phases that share a condition id run in the same condition. Omit for content shared by all conditions."
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "studyId",
        "kind",
        "title",
        "actorIds",
        "inputIds",
        "outputIds",
        "visibleIds",
        "children",
        "next",
        "evidenceIds"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "locator": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "pointer": {
              "type": "string"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "sheet": {
              "type": "string"
            },
            "cell": {
              "type": "string"
            },
            "region": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "quote": {
          "type": "string"
        },
        "verification": {
          "enum": [
            "verified",
            "unverified"
          ]
        }
      },
      "required": [
        "id",
        "locator"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "severity": {
          "enum": [
            "blocking",
            "decision",
            "check"
          ]
        },
        "reason": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        },
        "studyId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "fieldId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "stepId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        }
      },
      "required": [
        "id",
        "title",
        "severity",
        "reason",
        "impact",
        "suggestedAction",
        "evidenceIds"
      ],
      "additionalProperties": false
    }
  }
}
